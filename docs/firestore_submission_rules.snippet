// MEMBER 3 RULES SNIPPET
// Merge this match block into the team's existing firestore.rules file.
// It relies on Member 2's helper functions: isTalent(), isCompany(), isAdmin().
// Do not replace the rules for users, profiles, challenges or feedback.

function validSubmission(data) {
  return data.keys().hasAll([
      'challengeId', 'talentId', 'companyId', 'solutionText',
      'attachmentUrls', 'status', 'isShortlisted', 'submittedAt', 'updatedAt'
    ])
    && data.keys().hasOnly([
      'challengeId', 'talentId', 'companyId', 'solutionText',
      'attachmentUrls', 'status', 'isShortlisted', 'submittedAt',
      'updatedAt', 'reviewedAt'
    ])
    && data.challengeId is string
    && data.talentId is string
    && data.companyId is string
    && data.solutionText is string
    && data.solutionText.size() >= 30
    && data.solutionText.size() <= 10000
    && data.attachmentUrls is list
    && data.attachmentUrls.size() <= 10
    && data.status in ['submitted', 'under_review', 'reviewed']
    && data.isShortlisted is bool
    && data.submittedAt is timestamp
    && data.updatedAt is timestamp
    && (!data.keys().hasAny(['reviewedAt']) || data.reviewedAt is timestamp);
}

function challengeAllowsSubmission(data) {
  return exists(/databases/$(database)/documents/challenges/$(data.challengeId))
    && get(/databases/$(database)/documents/challenges/$(data.challengeId)).data.companyId == data.companyId
    && get(/databases/$(database)/documents/challenges/$(data.challengeId)).data.status == 'open'
    && get(/databases/$(database)/documents/challenges/$(data.challengeId)).data.deadline > request.time;
}

function validCompanyReviewTransition() {
  return (resource.data.status == 'submitted'
      && request.resource.data.status in ['under_review', 'reviewed'])
    || (resource.data.status == 'under_review'
      && request.resource.data.status == 'reviewed')
    || (resource.data.status == 'under_review'
      && request.resource.data.status == 'under_review')
    || (resource.data.status == 'reviewed'
      && request.resource.data.status == 'reviewed');
}

match /submissions/{submissionId} {
  allow get: if isAdmin()
    || (isTalent() && resource.data.talentId == request.auth.uid)
    || (isCompany() && resource.data.companyId == request.auth.uid);

  // List queries must constrain talentId or companyId to the authenticated UID.
  allow list: if isAdmin()
    || (isTalent() && resource.data.talentId == request.auth.uid)
    || (isCompany() && resource.data.companyId == request.auth.uid);

  // Submission IDs are generated by Firestore. The app performs a preflight
  // query to prevent ordinary duplicate submissions for a Talent/challenge pair.
  allow create: if isTalent()
    && validSubmission(request.resource.data)
    && request.resource.data.talentId == request.auth.uid
    && request.resource.data.status == 'submitted'
    && request.resource.data.isShortlisted == false
    && !request.resource.data.keys().hasAny(['reviewedAt'])
    && request.resource.data.submittedAt == request.time
    && request.resource.data.updatedAt == request.time
    && challengeAllowsSubmission(request.resource.data);

  // Talent can edit only solution content and links, only before review.
  allow update: if isAdmin()
    || (isTalent()
      && resource.data.talentId == request.auth.uid
      && resource.data.status == 'submitted'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'solutionText', 'attachmentUrls', 'updatedAt'
      ])
      && request.resource.data.solutionText is string
      && request.resource.data.solutionText.size() >= 30
      && request.resource.data.solutionText.size() <= 10000
      && request.resource.data.attachmentUrls is list
      && request.resource.data.attachmentUrls.size() <= 10
      && request.resource.data.updatedAt == request.time
      && challengeAllowsSubmission(resource.data))
    // Company can change only review state and shortlisting, never solution text.
    || (isCompany()
      && resource.data.companyId == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'isShortlisted', 'updatedAt', 'reviewedAt'
      ])
      && request.resource.data.challengeId == resource.data.challengeId
      && request.resource.data.talentId == resource.data.talentId
      && request.resource.data.companyId == resource.data.companyId
      && request.resource.data.solutionText == resource.data.solutionText
      && request.resource.data.attachmentUrls == resource.data.attachmentUrls
      && request.resource.data.submittedAt == resource.data.submittedAt
      && request.resource.data.status in ['under_review', 'reviewed']
      && request.resource.data.isShortlisted is bool
      && request.resource.data.updatedAt == request.time
      && validCompanyReviewTransition()
      && ((request.resource.data.status == 'reviewed'
          && request.resource.data.reviewedAt is timestamp
          && (resource.data.status == 'reviewed'
            ? request.resource.data.reviewedAt == resource.data.reviewedAt
            : request.resource.data.reviewedAt == request.time))
        || (request.resource.data.status == 'under_review'
          && !request.resource.data.keys().hasAny(['reviewedAt']))));

  // Talent may withdraw an unreviewed submission. Companies cannot delete it.
  allow delete: if isAdmin()
    || (isTalent()
      && resource.data.talentId == request.auth.uid
      && resource.data.status == 'submitted'
      && !exists(/databases/$(database)/documents/feedback/$(submissionId)));
}
